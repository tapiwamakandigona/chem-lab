# Appwrite *client* configuration. Both values are public by design: every
# browser request from an Appwrite client app carries them, and access is
# controlled by the project's platform hostname allowlist plus collection
# permissions — not by hiding these strings. The server API key is NOT here and
# never reaches the client.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=fra-69e62515000e9e781653
